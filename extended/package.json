{
  "name": "@pleistocent/tracive-sdk-extended-react-native",
  "version": "0.3.0",
  "description": "Lets a user report a scammer from inside your app, on Tracive's native form or your own React Native UI, and check that report's status.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pleistocent/tracive-sdk-react-native/tree/main/extended#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleistocent/tracive-sdk-react-native.git",
    "directory": "extended"
  },
  "bugs": {
    "url": "https://github.com/pleistocent/tracive-sdk-react-native/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "fraud",
    "scam",
    "report",
    "tracive"
  ],
  "type": "module",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "android",
    "ios",
    "TraciveSdkExtendedReactNative.podspec",
    "app.plugin.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/__tests__",
    "!**/.*",
    "!android/build",
    "!ios/build",
    "!ios/Frameworks"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "del-cli lib",
    "build": "bob build",
    "prepare": "bob build",
    "setup:local": "mkdir -p $(dirname node_modules/@pleistocent/tracive-sdk-react-native) && ln -sfn ../../.. node_modules/@pleistocent/tracive-sdk-react-native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "jest",
    "test:pod": "ruby tools/tracive_core_test.rb",
    "sync:swift": "bash tools/sync-swift-sources.sh",
    "sync:check": "bash tools/sync-swift-sources.sh --check",
    "hygiene": "npm --prefix .. run hygiene",
    "verify": "npm run hygiene && npm run sync:check && npm run typecheck && npm run lint && npm test && npm run test:pod && npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=54.0.0",
    "@pleistocent/tracive-sdk-react-native": ">=0.3.0",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^57.0.6",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@types/node": "^22.19.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__,types}/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TraciveSdkExtendedReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "id.tracive.sdk.extended.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "TraciveExtendedReports": "TraciveExtendedReports"
      }
    }
  }
}
