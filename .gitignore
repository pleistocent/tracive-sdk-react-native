node_modules/
lib/
coverage/
*.tgz
.DS_Store
*.log
.expo/

# The package's own native module lives in android/ and ios/ at the root; only their build output is
# ignored. `example/` is an Expo prebuild project whose native directories are checked in, because
# they carry the config plugin's output, the launcher artwork and the signing config.
/android/build/
/android/.gradle/
/android/.cxx/
/ios/build/

# One negation, for the same reason the Kotlin sample keeps one: the example's debug keystore is
# the well-known Android debug identity (alias `androiddebugkey`, password `android`), which Play
# rejects on upload. Every other keystore stays out of the tree.
*.keystore
!example/android/app/debug.keystore
